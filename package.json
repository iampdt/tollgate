{
  "name": "tollgate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An LLM gateway on Cloudflare's free tier: one OpenAI-compatible API in front of several model providers, with fallback, caching, per-key limits and tracing.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "loadtest": "tsx scripts/loadtest.ts",
    "eval:cache": "tsx scripts/eval-cache.ts",
    "deploy": "npm run check && wrangler deploy",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
